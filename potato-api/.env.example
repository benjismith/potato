# Port the API listens on.
PORT=3000

# MySQL connection string used by the API and drizzle-kit.
DATABASE_URL=mysql://root@localhost:3306/potato

# The user every management request runs as (v1 has no login). Leave unset to
# use the user created by `npm run db:seed` (usr_0000000000000000000000SEED).
# POTATO_CURRENT_USER_ID=

# MySQL database for integration tests (`npm test`). It's created and migrated
# automatically, and every table is truncated between tests, so the database
# name must end in "_test". Never point this at real data.
TEST_DATABASE_URL=mysql://root@localhost:3306/potato_test
